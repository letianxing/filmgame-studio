# URLs and paths below are safe local examples. Never place credentials here.
COMFYUI_HOME=G:\comfyui\resources\ComfyUI
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_PYTHON=
COMFYUI_BASE_DIRECTORY=G:\filmGame\filmgame-studio\.local\comfyui
COMFYUI_MEMORY_PROFILE=SAFE
COMFYUI_MINIMUM_FREE_RAM_BYTES=2147483648
COMFYUI_LOCAL_VIDEO_ENABLED=false
# Apple Silicon local Wan safe profile uses an FP16 text encoder on CPU.
WAN_TEXT_ENCODER=umt5_xxl_fp16.safetensors
# MLX is the tested Mac candidate; COMFYUI remains available for compatible workers.
WAN_RUNTIME=MLX
WAN_MLX_PYTHON=
WAN_MLX_MODEL_DIR=
WAN_MLX_HF_HOME=
WAN_MLX_WORKER=scripts/wan-mlx-worker.py
# FilmGame calls first-party gateways below. Vendor keys never go in this file.
# Enable after the matching gateway service .env.local is configured and started.
REMOTE_VIDEO_BASE_URL=
REMOTE_VIDEO_MODEL=
REMOTE_VIDEO_API_TOKEN=
VIDEO_PROVIDER_ATTEMPTS=2
VIDEO_PROVIDER_TIMEOUT_MS=1800000
VIDEO_PROVIDER_CIRCUIT_FAILURES=3
VIDEO_PROVIDER_CIRCUIT_COOLDOWN_MS=60000
REMOTE_AUDIO_BASE_URL=
REMOTE_MUSIC_MODEL=
REMOTE_SFX_MODEL=
REMOTE_AUDIO_API_TOKEN=
CODEX_CLI_LLM_ENABLED=false
CODEX_CLI_SCRIPT=
CODEX_CLI_MODEL=
# Provider-neutral LLM settings. Copy this file to .env.local and edit that file.
# Example provider IDs: openai-production, deepseek-production.
LLM_PROVIDER_ID=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=
LLM_STRUCTURED_MODE=JSON_SCHEMA
# OpenAI: max_completion_tokens. DeepSeek: max_tokens.
LLM_MAX_OUTPUT_TOKENS_FIELD=max_completion_tokens
COMFYUI_WORKFLOW_DIR=G:\filmGame\filmgame-studio\workflows\comfyui
COMFYUI_OUTPUT_DIR=G:\filmGame\filmgame-studio\artifacts\comfyui
ASSET_STORAGE_ROOT=G:\filmGame\filmgame-studio\.local\assets
# Set REMOTE_STORAGE_* only after services/storage-gateway is configured and started.
REMOTE_STORAGE_BASE_URL=
REMOTE_STORAGE_API_TOKEN=
MEDIA_WORK_ROOT=G:\filmGame\filmgame-studio\.local\media-work
# Durable linear-drama documents, reference uploads, completed shots and episode exports.
# Defaults to <working directory>/.local/drama; use a backed-up persistent volume when hosted.
DRAMA_STORAGE_ROOT=
PRODUCTION_ASSETS_COMMERCIAL_APPROVED=false
AUTO_APPROVE_QA_ASSETS=false
PRODUCTION_AUDIT_LOG=G:\filmGame\filmgame-studio\.local\audit\production.jsonl
RUNTIME_DEFINITION_ROOT=G:\filmGame\filmgame-studio\.local\assets\runtime-definitions
RUNTIME_EVENT_ROOT=G:\filmGame\filmgame-studio\.local\runtime-events
PRODUCTION_JOB_STATE_ROOT=G:\filmGame\filmgame-studio\.local\production-runs
PRODUCTION_COST_CURRENCY=CNY
PRODUCTION_COST_IMAGE=0
PRODUCTION_COST_VIDEO_SECOND=0
PRODUCTION_COST_TTS_CHARACTER=0
PRODUCTION_COST_MUSIC_SECOND=0
PRODUCTION_COST_SFX_SECOND=0
PRODUCTION_COST_MEDIA_JOB=0
FILMGAME_DEFAULT_MAX_BUDGET=
CANONICAL_ASSET_URI_MAP_JSON={}
TTS_STAGING_ROOT=G:\filmGame\filmgame-studio\.local\tts-staging

ORCHESTRATOR_PORT=4100
ORCHESTRATOR_API_TOKEN=
CREATOR_CONSOLE_ORIGIN=http://127.0.0.1:3000

COSYVOICE_HOME=G:\filmGame\CosyVoice
COSYVOICE_BASE_URL=http://127.0.0.1:50000
COSYVOICE_PYTHON=
COSYVOICE_MODEL_DIR=G:\filmGame\CosyVoice\pretrained_models\CosyVoice2-0.5B

FFMPEG_PATH=
FFPROBE_PATH=

UNREAL_ENGINE_ROOT=G:\Epic Games\UE_5.7
UNREAL_EDITOR_PATH=G:\Epic Games\UE_5.7\Engine\Binaries\Win64\UnrealEditor.exe
UNREAL_BUILD_TOOL_PATH=G:\Epic Games\UE_5.7\Engine\Binaries\DotNET\UnrealBuildTool\UnrealBuildTool.exe
UNREAL_AUTOMATION_TOOL_PATH=G:\Epic Games\UE_5.7\Engine\Binaries\DotNET\AutomationTool\AutomationTool.exe
VISUAL_STUDIO_ROOT=C:\Program Files (x86)\Microsoft Visual Studio\2022\BuildTools
WINDOWS_SDK_ROOT=C:\Program Files (x86)\Windows Kits\10

COLYSEUS_SERVER_URL=ws://127.0.0.1:2567
COLYSEUS_HTTP_URL=http://127.0.0.1:2567
NEXT_PUBLIC_COMPANION_URL=http://127.0.0.1:3001
ORCHESTRATOR_BASE_URL=http://127.0.0.1:4100
UNREAL_GATEWAY_PORT=2568

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

