{
  "name": "@filmgame/multiplayer-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "smoke": "tsx scripts/smoke-client.ts",
    "smoke:gateway": "tsx scripts/smoke-unreal-gateway.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@colyseus/schema": "5.0.8",
    "colyseus": "0.18.5",
    "ws": "^8.18.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.18.2",
    "@types/node": "22.19.19",
    "@types/ws": "^8.18.1",
    "tsx": "4.20.5",
    "typescript": "5.9.3"
  }
}
