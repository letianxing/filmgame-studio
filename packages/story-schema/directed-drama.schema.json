{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://filmgame.studio/schemas/directed-drama-1.0.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "fictionNotice",
    "aspectRatio",
    "resolution",
    "fps",
    "style",
    "referenceImages",
    "segments",
    "edit",
    "limits",
    "skillSources"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,79}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    },
    "fictionNotice": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    },
    "aspectRatio": {
      "enum": [
        "16:9",
        "9:16"
      ]
    },
    "resolution": {
      "enum": [
        "720p",
        "1080p"
      ]
    },
    "fps": {
      "enum": [
        24,
        25,
        30
      ]
    },
    "style": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    },
    "referenceImages": {
      "type": "array",
      "minItems": 0,
      "maxItems": 6,
      "items": {
        "type": "string",
        "pattern": "^references/[a-zA-Z0-9_-]+\\.(jpg|jpeg|png)$"
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "durationSeconds",
          "scene",
          "referenceSegments",
          "prompt",
          "shots",
          "dialogue"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,79}$"
          },
          "durationSeconds": {
            "type": "integer",
            "minimum": 4,
            "maximum": 30
          },
          "scene": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,79}$"
          },
          "referenceSegments": {
            "type": "array",
            "minItems": 0,
            "maxItems": 4,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,79}$"
            }
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          },
          "shots": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "start",
                "end",
                "size",
                "camera",
                "visual",
                "purpose"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,79}$"
                },
                "start": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 120
                },
                "end": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 120
                },
                "size": {
                  "enum": [
                    "WIDE",
                    "MEDIUM",
                    "CLOSE_UP",
                    "EXTREME_CLOSE_UP",
                    "INSERT",
                    "DETAIL"
                  ]
                },
                "camera": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16000
                },
                "visual": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16000
                },
                "purpose": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16000
                }
              }
            }
          },
          "dialogue": {
            "type": "array",
            "minItems": 0,
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "start",
                "end",
                "speaker",
                "text"
              ],
              "properties": {
                "start": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 120
                },
                "end": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 120
                },
                "speaker": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16000
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16000
                }
              }
            }
          }
        }
      }
    },
    "edit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audioLeadSeconds",
        "targetLufs",
        "title",
        "endCard",
        "subtitlePolicy"
      ],
      "properties": {
        "audioLeadSeconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "targetLufs": {
          "type": "number",
          "minimum": -24,
          "maximum": -14
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "endCard": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "subtitlePolicy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxInitialRequests",
        "maxOutputSeconds",
        "automaticRegeneration"
      ],
      "properties": {
        "maxInitialRequests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "maxOutputSeconds": {
          "type": "integer",
          "minimum": 4,
          "maximum": 120
        },
        "automaticRegeneration": {
          "const": false
        }
      }
    },
    "skillSources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "ref",
        "skills"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "skills": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          }
        }
      }
    }
  }
}
